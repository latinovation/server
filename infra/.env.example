# Plantilla de infra/.env. setup.sh la rellena; aquí se documenta cada valor.
# Nunca subas .env al repositorio.

# --- Modo ---
# local: docker-compose.yml + docker-compose.local.yml (LAN, HTTP en :8000 y :8080)
# prod:  docker-compose.yml + docker-compose.prod.yml  (VPS, Caddy con TLS en 80/443)
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Solo prod: dominio y TLS ---
# DNS: DOMAIN_BASE (relay) y cp.DOMAIN_BASE (control plane) → IP del VPS. No hay subdominio relay.
DOMAIN_BASE=org.latinovation.com
RELAY_DOMAIN=org.latinovation.com
ACME_EMAIL=ops@latinovation.com

# --- Versiones de imagen ---
CP_VERSION=latest
RELAY_VERSION=0.9.12

# --- Postgres (DATABASE_URL lleva la misma contraseña; setup.sh las mantiene sincronizadas) ---
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay
DATABASE_URL=postgresql+psycopg://relay:change-me@postgres:5432/relay

# --- MinIO (documentos y adjuntos) ---
MINIO_ROOT_USER=relay
MINIO_ROOT_PASSWORD=change-me

# --- Control plane ---
JWT_SECRET=change-me                     # openssl rand -hex 32
BOOTSTRAP_ADMIN_EMAIL=admin@latinovation.com
BOOTSTRAP_ADMIN_PASSWORD=change-me       # mínimo 8 caracteres; crea el primer admin si la BD está vacía
SERVER_NAME="Latinovation Org"
CORS_ALLOWED_ORIGINS="*"                   # en prod: https://cp.DOMAIN_BASE
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Relay: URLs y claves ---
# local: ws://<IP-LAN>:8080 y http://<IP-LAN>:8080   |   prod: wss://DOMAIN_BASE y https://DOMAIN_BASE
RELAY_PUBLIC_URL=ws://192.168.1.87:8080
RELAY_AUDIENCE=http://192.168.1.87:8080  # idéntico a [server].url de relay/relay.toml
RELAY_KEY_ID=relay_cp_dev
# Ed25519 en base64 del PEM: openssl genpkey -algorithm ed25519 -out relay_private.pem && openssl base64 -A -in relay_private.pem
# Guárdala: si cambia, se invalidan todos los tokens y hay que actualizar relay.toml.
RELAY_PRIVATE_KEY=

# --- Backup (infra/backup.sh, cron en el host) ---
BACKUP_RETENTION_DAYS=14
# Destino externo opcional para rclone/rsync, p. ej. "rclone:b2:latinovation-org-backups" o "user@host:/srv/backups"
BACKUP_REMOTE=
