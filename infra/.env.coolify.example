# ====================================================================
# Variables de Entorno para Coolify (EVC Team Relay — Producción VPS)
# ====================================================================
# Puedes generar automáticamente las claves secretas y el relay.toml
# ejecutando en tu terminal local:
#   ./infra/setup.sh prod org.latinovation.com ops@latinovation.com
# Y luego copiar los valores aquí.

# --- Dominios Públicos (Configura los registros DNS tipo A apuntando al VPS) ---
CP_DOMAIN=cp.org.latinovation.com
RELAY_DOMAIN=org.latinovation.com

# --- Versiones de Imágenes ---
CP_VERSION=latest
RELAY_VERSION=0.9.12

# --- Base de Datos Postgres ---
POSTGRES_USER=relay
POSTGRES_PASSWORD=genera_con_openssl_rand_hex_16
POSTGRES_DB=relay
DATABASE_URL=postgresql+psycopg://relay:genera_con_openssl_rand_hex_16@postgres:5432/relay

# --- MinIO (Almacenamiento S3 de documentos CRDT) ---
MINIO_ROOT_USER=relay
MINIO_ROOT_PASSWORD=genera_con_openssl_rand_hex_16

# --- Control Plane (API y Panel Admin) ---
JWT_SECRET=genera_con_openssl_rand_hex_32
BOOTSTRAP_ADMIN_EMAIL=admin@latinovation.com
BOOTSTRAP_ADMIN_PASSWORD=EligeUnaContraseñaSegura2026!
SERVER_NAME="Latinovation Org"
CORS_ALLOWED_ORIGINS=https://cp.org.latinovation.com
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Relay Server: URLs y Clave Criptográfica Ed25519 ---
# IMPORTANTE: RELAY_AUDIENCE debe ser IDÉNTICO a url en relay.toml
RELAY_PUBLIC_URL=wss://org.latinovation.com
RELAY_AUDIENCE=https://org.latinovation.com
RELAY_KEY_ID=relay_cp_prod

# Clave privada en Base64 generada con:
# openssl genpkey -algorithm ed25519 -out key.pem && openssl base64 -A -in key.pem
RELAY_PRIVATE_KEY=
